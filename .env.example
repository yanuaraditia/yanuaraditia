# ─────────────────────────────────────────────────────────────────────────────
# WeatherAPI (weatherapi.com)
# ─────────────────────────────────────────────────────────────────────────────
# Get a free key (no card required): https://www.weatherapi.com/signup.aspx
# Maps to runtimeConfig.weatherApiKey (server-only, never exposed to client).
# Used by server/api/weather.get.ts to drive the dynamic --color-super theme.
NUXT_WEATHER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Weather location (optional override — defaults to Sleman, Yogyakarta)
# Maps to runtimeConfig.public.weatherLocation.* (exposed to client).
# ─────────────────────────────────────────────────────────────────────────────
# NUXT_PUBLIC_WEATHER_LOCATION_LAT=-7.7172
# NUXT_PUBLIC_WEATHER_LOCATION_LON=110.3554
# NUXT_PUBLIC_WEATHER_LOCATION_NAME="Sleman, Yogyakarta"
